# GitHub Actions secrets used by .github/workflows/build.yml.
#
# Where to add them: GitHub repository > Settings > Secrets and variables > Actions >
# Secrets tab > New repository secret. Use the names below exactly.
# Or copy this file to .env, fill it in, and upload every entry at once with:
#   gh secret set -f .env
# Repository variables are in .env.variables.example, not here.
#
# Values marked "Base64" are file contents, not file paths. On macOS, copy a file as
# Base64 with:
#   base64 -i <file> | pbcopy
#
# Every group is optional. Leave a group empty and that platform is built unsigned,
# or that store upload is skipped; the run summary says what was skipped.

# macOS signing and notarization

# Base64 of a "Developer ID Application" certificate exported as .p12.
# Get it: developer.apple.com > Certificates, IDs & Profiles > Certificates > create
# "Developer ID Application", install it, then in Keychain Access right-click the
# certificate with its private key > Export > .p12.
CSC_LINK=
# The password you set when exporting that .p12.
CSC_KEY_PASSWORD=

# Base64 of an App Store Connect API key file (AuthKey_XXXXXXXXXX.p8), used for
# notarization. Get it: appstoreconnect.apple.com > Users and Access > Integrations >
# App Store Connect API > Team Keys > generate a key. The .p8 can be downloaded once only.
APPLE_API_KEY=
# The Key ID shown next to that key, for example 2X9R4HXF34.
APPLE_API_KEY_ID=
# The Issuer ID shown above the key list (a UUID).
APPLE_API_ISSUER=

# Windows signing

# Base64 of a Windows code signing certificate file (.pfx or .p12) that contains its
# private key. A certificate kept on a hardware token or in a cloud HSM cannot be used
# here. Leave it empty to build unsigned Windows installers.
WIN_CSC_LINK=
# The password of that .pfx or .p12.
WIN_CSC_KEY_PASSWORD=

# Android signing
# Without these, the APK and AAB are signed with the debug key and named "-test";
# Google Play rejects them.

# Base64 of the upload keystore (.jks). Create one once and keep a backup; every
# later update must be signed with the same key:
#   keytool -genkeypair -v -keystore upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
ANDROID_KEYSTORE_BASE64=
# The keystore password entered in keytool.
ANDROID_KEYSTORE_PASSWORD=
# The alias given to keytool, "upload" in the command above.
ANDROID_KEY_ALIAS=
# The key password entered in keytool; often the same as the keystore password.
ANDROID_KEY_PASSWORD=

# iOS signing
# Without these, iOS only produces an unsigned archive for build checks.

# Base64 of an "Apple Distribution" certificate exported as .p12 (same steps as
# CSC_LINK, but choose "Apple Distribution" when creating the certificate).
IOS_CERTIFICATE_BASE64=
# The password you set when exporting that .p12.
IOS_CERTIFICATE_PASSWORD=
# Base64 of an App Store distribution provisioning profile (.mobileprovision).
# Get it: developer.apple.com > Certificates, IDs & Profiles > Profiles > create
# "App Store Connect" for the appId in product.conf.json and the certificate above,
# then download it.
IOS_PROVISIONING_PROFILE_BASE64=

# Store uploads (only for tags whose version equals versions.mobile in product.conf.json)

# Base64 of a Google Cloud service account JSON key that may publish to Google Play.
# Get it: in console.cloud.google.com, enable the Google Play Android Developer API for the
# project, then IAM & Admin > Service Accounts > create one >
# Keys > Add key > JSON. Then in play.google.com/console > Users and permissions >
# invite the service account email and allow it to release the app.
# The app must already exist in Play Console, with one AAB uploaded by hand first.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=

# Base64 of an App Store Connect API key file (AuthKey_XXXXXXXXXX.p8) for uploading iOS
# builds. Get it the same way as APPLE_API_KEY; that same key can be reused if its role
# is App Manager or Admin. The app must already exist in App Store Connect with the
# appId from product.conf.json.
APP_STORE_CONNECT_API_KEY_BASE64=
# The Key ID shown next to that key, for example 2X9R4HXF34.
APP_STORE_CONNECT_KEY_ID=
# The Issuer ID shown above the key list (a UUID).
APP_STORE_CONNECT_ISSUER_ID=

# Releases repository
# Set both to publish releases in another repository; leave both empty to publish in
# this repository.
# Each release commits releases.json there (the latest desktop and mobile versions),
# tags that commit, then publishes the release on that tag.

# owner/name of that repository, for example joyx/chorus-releases. Create it on
# GitHub first; it may be empty.
RELEASES_REPOSITORY=
# A fine-grained token that may write releases there. Get it:
# github.com/settings/personal-access-tokens > Generate new token > Repository access:
# Only select repositories > the releases repository > Permissions: Contents > Read and
# write. Renew it before it expires. The value starts with github_pat_.
RELEASES_TOKEN=
